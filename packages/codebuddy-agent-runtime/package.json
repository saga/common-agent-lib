{
  "name": "@saga/codebuddy-agent-runtime",
  "version": "0.1.0",
  "description": "Reusable runtime adapter for Tencent CodeBuddy Agent SDK (WorkBuddy/CodeBuddy)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "0.3.276"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.1"
  }
}
