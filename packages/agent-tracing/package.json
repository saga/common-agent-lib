{
  "name": "@saga/agent-tracing",
  "version": "0.1.0",
  "description": "Provider-neutral agent trace recording, redaction, bounded payloads and local SQLite persistence.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@saga/agent-contracts": "0.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
